{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tesseract-gov-website.vercel.app" }],
      "destination": "https://gov.tesseract.academy/:path*",
      "permanent": true
    },
    {
      "source": "/ns/seom",
      "destination": "/data/skills-england/ontology/seom-vocabulary.ttl",
      "permanent": false
    },
    {
      "source": "/id/seom/:path*",
      "destination": "/research/skills-england-occupational-maps",
      "permanent": false
    },
    {
      "source": "/case-studies/connective-product-cyber-incidents",
      "destination": "/research/connective-product-cyber-incidents",
      "permanent": true
    },
    { "source": "/case-studies/welsh-government-land-valuation", "destination": "/research/welsh-government-land-valuation", "permanent": true },
    { "source": "/case-studies/national-digital-twin-programme", "destination": "/research/national-digital-twin-programme", "permanent": true },
    { "source": "/case-studies/bridgeai-creative-industries", "destination": "/research/bridgeai-creative-industries", "permanent": true },
    { "source": "/case-studies/kalgera-financial-vulnerability", "destination": "/research/kalgera-financial-vulnerability", "permanent": true },
    { "source": "/case-studies/wastewater-effluent-data-quality", "destination": "/research/wastewater-effluent-data-quality", "permanent": true },
    { "source": "/case-studies/wrap-food-loss-waste-taxonomy", "destination": "/research/wrap-food-loss-waste-taxonomy", "permanent": true },
    { "source": "/case-studies/agri-environment-heritage-value", "destination": "/research/agri-environment-heritage-value", "permanent": true },
    { "source": "/case-studies/fair-scientific-data", "destination": "/research/fair-scientific-data", "permanent": true },
    { "source": "/case-studies/ies-hqdm-defence-interoperability", "destination": "/research/ies-hqdm-defence-interoperability", "permanent": true },
    { "source": "/research/basis-risk-false-negative", "destination": "/research/parametric-payout-assurance", "permanent": true },
    { "source": "/research/pre-event-payability", "destination": "/research/parametric-payout-assurance", "permanent": true },
    { "source": "/research/spatial-basis-disclosure", "destination": "/research/parametric-payout-assurance", "permanent": true },
    { "source": "/research/verification-burden-paradox", "destination": "/research/parametric-payout-assurance", "permanent": true },
    { "source": "/research/assurance-provenance-discipline", "destination": "/research/parametric-payout-assurance", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/|llms\\.txt|llms-full\\.txt|robots\\.txt|sitemap\\.xml|\\.well-known|\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.emailjs.com; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/api/company.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
